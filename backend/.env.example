DATABASE_URL=postgresql://postgres:TU_NUEVA_CONTRASENA@localhost:5432/observabilidad_db
SENDER_EMAIL=
SENDER_PASSWORD=
SECRET_KEY=
GROQ_API_KEY=

# Configuracion SMTP.
# Por defecto se mantienen STARTTLS y autenticacion.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_AUTH=true

# Mailpit: correo local para pruebas sin Gmail.
# Activar el perfil correo-local de Docker Compose.
# Copiar estos valores a backend/.env cuando se use Mailpit:
# SMTP_SERVER=mailpit
# SMTP_PORT=1025
# SMTP_STARTTLS=false
# SMTP_AUTH=false
# SENDER_EMAIL=no-responder@plurione.local
# SENDER_PASSWORD=
# Estos valores son para pruebas locales, no para produccion.

# Origenes permitidos para HTTP y WebSocket.
# Separar varios origenes mediante comas.
# Para pruebas aisladas agregar los origenes del puerto 5175.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
