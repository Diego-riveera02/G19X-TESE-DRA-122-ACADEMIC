DATABASE_URL=postgresql://postgres:TU_NUEVA_CONTRASENA@localhost:5432/observabilidad_db
SENDER_EMAIL=
SENDER_PASSWORD=
SECRET_KEY=
GROQ_API_KEY=

# Configuracion SMTP.
# Por defecto se mantienen STARTTLS y autenticacion.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_AUTH=true

# Solo para servidores locales de pruebas como Mailpit:
# Configurar servidor y puerto del entorno aislado.
# SMTP_STARTTLS=false y SMTP_AUTH=false.
